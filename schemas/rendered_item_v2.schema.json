{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval_format_mvp_rendered_item_v2.schema.json",
  "title": "Rendered crossed purpose-by-format item (v2)",
  "type": "object",
  "required": [
    "schema_version",
    "item_id",
    "payload_block_id",
    "topic_id",
    "task_family",
    "intended_purpose",
    "label",
    "format",
    "render_slot",
    "purpose_pair_id",
    "purpose_family_id",
    "cue_style",
    "cue_perspective",
    "cue_locus",
    "format_variant_id",
    "format_family_id",
    "text",
    "correct_answer",
    "answer_key",
    "canonical_payload_sha256",
    "rendered_text_sha256",
    "split_group_id",
    "frame_assignment_scheme"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "item_id": {"type": "string", "minLength": 1},
    "payload_block_id": {"type": "string", "pattern": "^pb_[a-z0-9_]{3,48}$"},
    "topic_id": {"type": "string", "pattern": "^t[0-9]{3}$"},
    "task_family": {"type": "string", "minLength": 1},
    "intended_purpose": {"enum": ["evaluation", "deployment", "none"]},
    "label": {"enum": [0, 1, null]},
    "format": {"enum": ["benchmark", "casual"]},
    "render_slot": {"enum": ["stated", "indirect", "second_person", "no_cue"]},
    "purpose_pair_id": {"type": "string", "pattern": "^(vp[0-9]{2}|none)$"},
    "purpose_family_id": {"type": "string", "pattern": "^(fg[1-5]|none)$"},
    "cue_style": {"enum": ["stated", "indirect", "none"]},
    "cue_perspective": {"enum": ["third", "second", "none"]},
    "cue_locus": {"enum": ["noun_only", "verb_only", "both", "context", "none"]},
    "format_variant_id": {"type": "string", "minLength": 1},
    "format_family_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "correct_answer": {"type": "string", "minLength": 1},
    "answer_key": {"type": ["string", "null"]},
    "canonical_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rendered_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_group_id": {"type": "string", "minLength": 1},
    "frame_assignment_scheme": {"const": "crossed_bibd_v2"},
    "cue_text": {"type": "string", "minLength": 1},
    "cue_char_start": {"type": "integer", "minimum": 0},
    "cue_char_end": {"type": "integer", "minimum": 1},
    "cue_position": {"enum": ["start", "body"]},
    "message_role": {"enum": ["user", "system"]}
  },
  "additionalProperties": false
}
