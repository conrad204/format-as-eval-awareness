{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval_format_mvp_rendered_item_v3.schema.json",
  "title": "Rendered item, format-catalog v2 lane (purpose x template x contract)",
  "type": "object",
  "required": [
    "schema_version",
    "item_id",
    "payload_block_id",
    "topic_id",
    "task_family",
    "intended_purpose",
    "label",
    "format",
    "template_id",
    "contract_id",
    "template_mode",
    "render_slot",
    "purpose_pair_id",
    "purpose_family_id",
    "cue_style",
    "cue_perspective",
    "cue_locus",
    "heading_style",
    "option_style",
    "serialization",
    "register",
    "terminal_field",
    "legacy",
    "text",
    "correct_answer",
    "answer_key",
    "canonical_payload_sha256",
    "rendered_text_sha256",
    "split_group_id",
    "frame_assignment_scheme",
    "cue_text",
    "cue_char_start",
    "cue_char_end",
    "cue_position",
    "message_role"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "item_id": { "type": "string", "minLength": 1 },
    "payload_block_id": { "type": "string", "pattern": "^pb_[a-z0-9_]{3,48}$" },
    "topic_id": { "type": "string", "pattern": "^t[0-9]{3}$" },
    "task_family": { "type": "string", "minLength": 1 },
    "intended_purpose": { "enum": ["evaluation", "deployment", "none"] },
    "label": { "enum": [0, 1, null] },
    "format": { "enum": ["benchmark", "casual"] },
    "template_id": { "type": "string", "minLength": 1 },
    "contract_id": { "enum": ["C0", "C1", "C2", "C3", "C4", null] },
    "template_mode": { "enum": ["choice", "gsm8k", null] },
    "render_slot": { "enum": ["stated", "no_cue"] },
    "purpose_pair_id": { "type": "string", "pattern": "^(vp[0-9]{2}|none)$" },
    "purpose_family_id": { "type": "string", "pattern": "^(fg[1-5]|none)$" },
    "cue_style": { "enum": ["stated", "none"] },
    "cue_perspective": { "enum": ["third", "none"] },
    "cue_locus": { "enum": ["noun_only", "verb_only", "both", "none"] },
    "heading_style": { "type": "string", "minLength": 1 },
    "option_style": { "type": "string", "minLength": 1 },
    "serialization": { "type": "string", "minLength": 1 },
    "register": { "type": "string", "minLength": 1 },
    "terminal_field": { "type": ["string", "null"] },
    "legacy": { "type": "boolean" },
    "text": { "type": "string", "minLength": 1 },
    "correct_answer": { "type": "string", "minLength": 1 },
    "answer_key": { "type": ["string", "null"] },
    "canonical_payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rendered_text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "split_group_id": { "type": "string", "minLength": 1 },
    "frame_assignment_scheme": { "enum": ["crossed_formats_v3", "crossed_formats_v3_full"] },
    "cue_text": { "type": ["string", "null"] },
    "cue_char_start": { "type": ["integer", "null"], "minimum": 0 },
    "cue_char_end": { "type": ["integer", "null"], "minimum": 0 },
    "cue_position": { "enum": ["start", "body", null] },
    "message_role": { "const": "user" }
  },
  "additionalProperties": false
}
